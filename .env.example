# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local (web) / .env (mobile) and fill in.
# NEVER commit the filled-in files — .gitignore already excludes them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (public — safe to ship in a client bundle) ──────────────────────
# Dashboard → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Expo needs the same two values under an EXPO_PUBLIC_ prefix
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...


# ─────────────────────────────────────────────────────────────────────────────
# EDGE FUNCTION SECRETS — these are NOT read from this file at runtime.
# Set them on the Supabase project instead, so they never touch a bundle:
#
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set SERPAPI_API_KEY=...
#   supabase secrets set AMAZON_PROVIDER=serpapi
#
# For local `supabase functions serve`, put them in supabase/.env.local
#
# The service_role / `sb_secret_...` key is NOT needed for deployed functions:
# Supabase injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY into the edge
# runtime automatically. It is only required in supabase/.env.local for local
# `functions serve`. It bypasses Row Level Security entirely, so it must never
# appear in a NEXT_PUBLIC_* or EXPO_PUBLIC_* variable.
# ─────────────────────────────────────────────────────────────────────────────

# Which Amazon data source the recommend function uses.
#   fixtures = offline canned results, no key needed, no quota burned  (default)
#   serpapi  = live Amazon data
AMAZON_PROVIDER=fixtures

# console.anthropic.com — used for vague-description → search-keyword expansion
ANTHROPIC_API_KEY=

# serpapi.com — free tier is 250 searches/month
SERPAPI_API_KEY=

# Amazon marketplace domain + optional Associates tag for outbound links
AMAZON_DOMAIN=amazon.com
AMAZON_ASSOCIATE_TAG=

# Per-user search rate limit (protects your SerpApi quota)
SEARCH_RATE_LIMIT_PER_HOUR=20


# ─────────────────────────────────────────────────────────────────────────────
# Auth is email + password, handled entirely by Supabase — no OAuth client IDs
# and no extra environment variables needed.
#
# Two dashboard settings worth knowing (Authentication → Providers → Email):
#   * "Confirm email" is ON by default. Turn it off to skip the confirmation
#     step while developing.
#   * Supabase's built-in mailer is rate-limited and for testing only. Add your
#     own SMTP provider under Authentication → Emails before going live, or
#     confirmation and password-reset emails will silently stop arriving.
# ─────────────────────────────────────────────────────────────────────────────
